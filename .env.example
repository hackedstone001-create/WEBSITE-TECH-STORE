# ==============================================================================
# TECH STORE — ENVIRONMENT CONFIGURATION
# ==============================================================================

# SUPABASE CONFIGURATION
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# RAZORPAY PAYMENT GATEWAY (TEST OR PRODUCTION)
# Obtain from https://dashboard.razorpay.com/#/app/keys
# In test mode, use key_id prefix rzp_test_
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_key

# APP CONFIGURATION
NEXT_PUBLIC_APP_NAME="TECH STORE"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@techstore.io
NEXT_PUBLIC_WHATSAPP_NUMBER=+919876543210
